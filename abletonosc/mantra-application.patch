+        #--------------------------------------------------------------------------------
+        # Ableton Live Remote (Mantra), 24.11.2026: the phone's whole picture of the set in ONE question, so its helper
+        # takes the shared turn on 11011 once per look and lets it go (liveosc.py: use, let go).
+        #   /live/mantra/remote/state   playing, song time, tempo, metronome, loop, loop start, loop length, record mode,
+        #       signature numerator, denominator, song end, track count, then 9 per track: name, colour, kind, arm, mute,
+        #       solo, audio clips on the timeline, clip sum (changes when a clip moves), volume
+        #       kind bits: 1 can be armed, 2 audio track, 4 group, 8 inside a group; arm -1 when it cannot be armed
+        #   /live/mantra/remote/clips <track>   track, clips, then per audio clip on the timeline (sorted by start):
+        #       file path, start, end, start marker, end marker (seconds unwarped, beats warped), warping, muted, warp
+        #       markers n, then n pairs (beat, seconds)
+        #--------------------------------------------------------------------------------
+        def read_mode_early():
+            try:
+                with open(os.path.expanduser("~/.config/mantra-live-playback-mode")) as f: m = f.read().strip()
+            except Exception:
+                m = ""
+            return m if m in ("return", "continue") else "return"
+
+        def remote_audio_clips(track):
+            if track.is_foldable:
+                return []
+            try:
+                return sorted([c for c in track.arrangement_clips if c.is_audio_clip], key=lambda c: c.start_time)
+            except Exception:
+                return []
+
+        def remote_state(_) -> Tuple:
+            song = Live.Application.get_application().get_document()
+            end = float(song.song_length)
+            try: end = float(song.last_event_time)
+            except Exception: pass
+            out = [int(song.is_playing), float(song.current_song_time), float(song.tempo), int(song.metronome),
+                   int(song.loop), float(song.loop_start), float(song.loop_length), int(song.record_mode),
+                   int(song.signature_numerator), int(song.signature_denominator), end, len(song.tracks)]
+            for t in song.tracks:
+                kind = 0
+                armable = False
+                try: armable = bool(t.can_be_armed)
+                except Exception: pass
+                if armable: kind |= 1
+                try:
+                    if t.has_audio_input and not t.is_foldable: kind |= 2
+                except Exception: pass
+                if t.is_foldable: kind |= 4
+                try:
+                    if t.is_grouped: kind |= 8
+                except Exception: pass
+                clips = remote_audio_clips(t)
+                csum = 0.0
+                for c in clips: csum += float(c.start_time) * 3.0 + float(c.end_time) * 7.0 + float(c.start_marker) + int(c.muted)
+                vol = 0.0
+                try: vol = float(t.mixer_device.volume.value)
+                except Exception: pass
+                out += [str(t.name), int(t.color), kind, (int(t.arm) if armable else -1), int(t.mute),
+                        int(t.solo), len(clips), csum, vol]
+            # 24.11.2026, after the tracks (older readers stop before them): the insert point and the playback mode
+            out += [float(song.start_time), read_mode_early()]
+            # then one stable identity per track (Live's object pointer: the same through renames and moves)
+            out += [str(getattr(t, "_live_ptr", id(t))) for t in song.tracks]
+            return tuple(out)
+        self.osc_server.add_handler("/live/mantra/remote/state", remote_state)
+
+        def remote_clips(params) -> Tuple:
+            index = int(params[0])
+            song = Live.Application.get_application().get_document()
+            if index < 0 or index >= len(song.tracks): return (index, -1)
+            clips = remote_audio_clips(song.tracks[index])
+            out = [index, len(clips)]
+            for c in clips:
+                markers = []
+                if c.warping:
+                    try:
+                        for m in c.warp_markers: markers += [float(m.beat_time), float(m.sample_time)]
+                    except Exception: markers = []
+                out += [str(c.file_path), float(c.start_time), float(c.end_time), float(c.start_marker), float(c.end_marker),
+                        int(c.warping), int(c.muted), len(markers) // 2] + markers
+            return tuple(out)
+        self.osc_server.add_handler("/live/mantra/remote/clips", remote_clips)
+
+        #   /live/mantra/remote/song_dir <part>   the names of Song's attributes containing <part> (a probe, 24.11.2026)
+        def remote_song_dir(params) -> Tuple:
+            song = Live.Application.get_application().get_document()
+            part = str(params[0]).lower() if params else ""
+            return tuple(n for n in dir(song) if part in n.lower() and not n.startswith("_"))
+        self.osc_server.add_handler("/live/mantra/remote/song_dir", remote_song_dir)
+
+        #   /live/mantra/start_time [beats]   Live's insert point (Song.start_time, where Play and Space start): read, or set
+        #   (Ableton Live Remote, 24.11.2026: "every time I click play, it plays from the beginning")
+        def remote_start_time(params) -> Tuple:
+            song = Live.Application.get_application().get_document()
+            if params: song.start_time = max(0.0, float(params[0]))
+            return (float(song.start_time),)
+        self.osc_server.add_handler("/live/mantra/start_time", remote_start_time)
+
+        #--------------------------------------------------------------------------------
+        # The playback mode, Live's own behaviour after ANY stop (Space, Live's buttons, a controller, OSC), with or
+        # without the phone (Marko, 24.11.2026: "two ways of playback ... DAW playback or DaVinci playback ... It's
+        # setting Ableton Live actually"):
+        #   "return"    the DAW way: the playhead goes back to the insert point; every Play starts there again
+        #   "continue"  the editing way (DaVinci Resolve): the insert point moves to where playback stopped
+        # Kept in ~/.config/mantra-live-playback-mode (one word), read again on every change, so Ableton Live Assistant and
+        # the remote's helper set the same switch. Watched here every 100 ms tick; a change made from a scheduled message
+        # is allowed (a listener callback may not change the song).
+        #   /live/mantra/playback_mode [return|continue]   answers the mode (and sets it when given)
+        #--------------------------------------------------------------------------------
+        import os
+        mode_file = os.path.expanduser("~/.config/mantra-live-playback-mode")
+
+        def read_mode():
+            try:
+                with open(mode_file) as f: m = f.read().strip()
+            except Exception:
+                m = ""
+            return m if m in ("return", "continue") else "return"
+
+        def playback_mode(params) -> Tuple:
+            if params and str(params[0]) in ("return", "continue"):
+                try:
+                    os.makedirs(os.path.dirname(mode_file), exist_ok=True)
+                    with open(mode_file, "w") as f: f.write(str(params[0]) + "\n")
+                except Exception as e:
+                    self.logger.error("playback mode not written: %s" % e)
+            return (read_mode(),)
+        self.osc_server.add_handler("/live/mantra/playback_mode", playback_mode)
+
+        manager = self.manager
+        generation = getattr(manager, "_mantra_playback_gen", 0) + 1
+        manager._mantra_playback_gen = generation          # a reload starts a new watcher; the old one sees this and ends
+        watch = {"was": False, "mode": read_mode(), "checked": 0}
+
+        def watch_stop():
+            if getattr(manager, "_mantra_playback_gen", 0) != generation:
+                return
+            try:
+                song = Live.Application.get_application().get_document()
+                playing = bool(song.is_playing)
+                watch["checked"] += 1
+                if watch["checked"] % 10 == 0:
+                    watch["mode"] = read_mode()               # once a second: the switch may have been turned elsewhere
+                if watch["was"] and not playing:
+                    mode = read_mode()
+                    watch["mode"] = mode
+                    if mode == "continue":
+                        song.start_time = float(song.current_song_time)
+                    else:
+                        song.current_song_time = float(song.start_time)
+                watch["was"] = playing
+            except Exception as e:
+                self.logger.error("playback mode watcher: %s" % e)
+            manager.schedule_message(1, watch_stop)
+        manager.schedule_message(1, watch_stop)
+
+        #   /live/mantra/remote/track_ids   a stable identity per track (Live's own object pointer, the same while the track
+        #   lives, whatever it is renamed or moved to) (24.11.2026)
+        def remote_track_ids(_) -> Tuple:
+            song = Live.Application.get_application().get_document()
+            return tuple(str(getattr(t, "_live_ptr", id(t))) for t in song.tracks)
+        self.osc_server.add_handler("/live/mantra/remote/track_ids", remote_track_ids)
