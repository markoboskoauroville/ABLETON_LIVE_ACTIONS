+        #   needs to be fixed inside Ableton Live, pushing every 20 seconds audio to match")
+        def arrangement_warp_markers(params) -> Tuple:
+            track = Live.Application.get_application().get_document().tracks[int(params[0])]
+            clips = sorted([c for c in track.arrangement_clips if c.is_audio_clip], key=lambda c: c.start_time)
+            if not clips: return (int(params[0]), -1)
+            c = clips[0]
+            if len(params) > 2:
+                c.warping = True
+                c.warp_mode = int(params[1])
+                pairs = [(float(params[i]), float(params[i + 1])) for i in range(2, len(params) - 1, 2)]
+                old = [float(m.beat_time) for m in c.warp_markers]
